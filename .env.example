# EKAFY Environment Configuration
NODE_ENV=production
PORT=3000
APP_NAME=NearRide
APP_URL=https://nearride.ekafy.app
API_BASE_URL=https://nearride.ekafy.app/api/v1

# EKAFY Standard MariaDB Connection
DB_HOST=ekafy-mariadb
DB_PORT=3306
DB_NAME=db_tenant_nearride
DB_USER=ekafy_admin
DB_PASSWORD=your_secure_db_password
DB_CONNECTION_LIMIT=10

# Optional: Full Connection String (EKAFY platform standard)
DATABASE_URL=mysql://ekafy_admin:your_secure_db_password@ekafy-mariadb:3306/db_tenant_nearride

# Authentication & Security Secrets
# Replace with random secrets of at least 32 characters
JWT_ACCESS_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# 32-byte (64 hex characters) key for encrypting registration & license numbers
# IMPORTANT: Never change this once set, or encrypted data cannot be decrypted!
REGISTRATION_ENCRYPTION_KEY=replace_with_32_byte_hex_key_material

# File Upload Settings
UPLOAD_DIRECTORY=public/uploads
MAX_IMAGES_PER_LISTING=2
MAX_IMAGE_SIZE_MB=5

# Marketplace Rules & Search Defaults
AUTO_APPROVE_LISTINGS=false
DEFAULT_LISTING_EXPIRY_DAYS=60
DEFAULT_SEARCH_RADIUS_KM=25

# CORS Settings (comma-separated origins allowed to access the API)
CORS_ORIGINS=https://nearride.ekafy.com

# Optional Third-Party Services
GOOGLE_CLIENT_ID=
